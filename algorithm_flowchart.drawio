        <mxCell id="s2_1" value="예측 단계 (Prediction)&#xa;OpenDrift 출력 → 파티클 위치 갱신" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="sec2">
