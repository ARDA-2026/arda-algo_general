          <mxGeometry x="200" y="400" width="660" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="s2_sensor" value="센서 관측값&#xa;열화상 / 광학 카메라" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="sec2">
