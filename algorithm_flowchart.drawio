        </mxCell>

        <mxCell id="s1_2" value="유속 벡터 적용 (dynamics_fn)&#xa;Runge-Kutta 4차 + 확산계수" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="sec1">
          <mxGeometry x="180" y="130" width="300" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="s1_3" value="파티클 전파 (t → t+Δt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="sec1">
          <mxGeometry x="180" y="190" width="300" height="40" as="geometry"/>
        </mxCell>

        <!-- 섹션1 내부 화살표 -->
