        <mxCell id="input" value="입수 좌표 + 시각" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="30" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- ======================== -->
        <!-- 섹션 1: OpenDrift/Leeway -->
        <!-- ======================== -->
        <mxCell id="sec1" value="1. OpenDrift / Leeway" style="swimlane;startSize=30;fillColor=#f3e8ff;strokeColor=#9c5fb5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="660" height="240" as="geometry"/>
        </mxCell>

        <mxCell id="s1_1" value="파티클 초기화&#xa;입수 좌표 중심, N=500, 반경 10m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="sec1">
