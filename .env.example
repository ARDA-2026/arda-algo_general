# 한강홍수통제소 Open API 키
# https://www.hrfco.go.kr/web/openapiPage/openApi.do 에서 발급 후 아래에 입력
API_KEY=YOUR_API_KEY_HERE

# ─────────────────────────────────────────
# 네이버 지도 Static Map API  (지도 배경)
# ─────────────────────────────────────────
# 네이버 클라우드 플랫폼 콘솔 > Services > AI·NAVER API > Application
#   1. Application 등록(또는 기존 것 수정)
#   2. "Maps" 안에서  Static Map  을 체크해 권한을 추가   <-- 이게 핵심
#   3. 인증정보 탭의 Client ID / Client Secret 을 아래에 입력
#
# Web Dynamic Map(JS) 키와는 별개다. Static Map 은 서버가 호출하므로
# 도메인 등록이 아니라 Client Secret 으로 인증한다.
#
# 서버가 처음 켜질 때(인터넷 연결 상태에서) 지도 영역에 맞는 배경을 받아
# cache/basemap/ 에 구워 둔다. 그 뒤로는 오프라인에서도 같은 파일을 쓴다.
NAVER_MAP_STATIC_KEY_ID=YOUR_CLIENT_ID_HERE
NAVER_MAP_STATIC_KEY=YOUR_CLIENT_SECRET_HERE
